  "fake_ip_ranges": [
    "198.18.0.0/15",
    "100.64.0.0/10"
  ],
  "host_ip_overrides": {
    "https://intra.company.example": "10.10.0.21",
    "https://portal.internal.company.example": "10.10.0.22"
  }
}
