{
  "prefixes": [
    "https://vpn.school.example",
    "https://intra.company.example",
    "https://portal.internal.company.example"
  ],
  "interval_seconds": 120,
  "local_gateway": null,
  "state_file": ".vpn_route_bypass_state.json",
